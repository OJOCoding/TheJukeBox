root = true

[*]
charset = utf-8

# LF, matching what git actually stores and what .gitattributes now checks out on every
# platform. This said crlf, and the combination could not pass CI: git normalises to LF in the
# object store, a Windows checkout with core.autocrlf=true converts back to CRLF so
# `dotnet format` agrees locally, and a Linux runner checks out the LF that is really there and
# fails every C# file. The first CI run this repository ever did failed on exactly that.
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx}]
indent_size = 4

[*.{js,mjs,html,json,yml,yaml}]
indent_size = 2

# The stylesheets have always been 4-space. Aligning the config to the code beats
# reformatting 537 lines for no benefit.
[*.css]
indent_size = 4

[*.{csproj,props,targets,config}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# Prefer modern expression styles
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_collection_expression = when_types_loosely_match:suggestion

# Nullability and correctness are not negotiable in new code
dotnet_diagnostic.CS8600.severity = warning
dotnet_diagnostic.CS8602.severity = warning
dotnet_diagnostic.CS8603.severity = warning
dotnet_diagnostic.CS8618.severity = warning

# ConfigureAwait(false) is noise in an ASP.NET Core app (no sync context)
dotnet_diagnostic.CA2007.severity = none

# EF Core writes migrations in its own style (block-scoped namespaces, its own
# formatting) and they are regenerated by tooling, so hand-written style rules do not
# apply and editing them to satisfy an analyzer would be undone on the next scaffold.
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

# Test method names read as sentences (Escapes_backslashes_before_quotes), which is
# the xUnit convention and worth more than CA1707's no-underscores rule.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
# CA1859 wants concrete types for performance. Tests hold the abstraction on purpose
# -- exercising the interface the application depends on is the point -- and test code
# is not on any hot path.
dotnet_diagnostic.CA1859.severity = none

[*.cs]
# Naming: private fields _camelCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_prefix
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_prefix.capitalization = camel_case
dotnet_naming_style.underscore_prefix.required_prefix = _
