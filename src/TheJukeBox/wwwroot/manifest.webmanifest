{
  "name": "TheJukeBox",
  "short_name": "JUKEBOX",
  "description": "Stream your Google Drive music library.",

  "start_url": "/library",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",

  "background_color": "#ffffff",
  "theme_color": "#ffffff",

  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],

  "shortcuts": [
    { "name": "Library", "url": "/library" },
    { "name": "Queue", "url": "/queue" }
  ]
}
