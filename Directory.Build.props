<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Globalization is invariant: every string comparison in this project is
    Ordinal or *Invariant by design, and dropping ICU keeps the container small.
  -->
  <PropertyGroup>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Warnings become errors once the legacy single-user auth files are deleted in
    phase A4. Until then the pre-existing nullable violations in
    API/GoogleAPI_Service.cs and CORE/GoogleAuthConfig.cs would block the build,
    and fixing code that is about to be removed is wasted work.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
