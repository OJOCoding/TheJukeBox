# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# This project has already had a client secret and a live refresh token committed to a
# public repository once. Rotating credentials at Google is the only thing that fixes
# that, because deleting a file does not remove it from git history.

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------
# From https://console.cloud.google.com/apis/credentials, as an "OAuth client ID" of
# type "Web application". You must also enable the Google Drive API for the project.
JUKEBOX_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
JUKEBOX_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Where this instance lives
# ---------------------------------------------------------------------------
# Absolute, no trailing slash. Register these two redirect URIs in Cloud Console,
# verbatim, substituting this value:
#
#   <APP_PUBLIC_BASE_URL>/api/auth/callback
#   <APP_PUBLIC_BASE_URL>/api/auth/drive/callback
#
# The app logs both at startup so you can copy them.
APP_PUBLIC_BASE_URL=https://music.example.com

# Trust X-Forwarded-Proto and X-Forwarded-Host from any peer. Correct when a reverse
# proxy is the only way in, wrong if the container port is directly reachable.
APP_TRUST_PROXY=true

# ---------------------------------------------------------------------------
# Who is allowed to have an account
# ---------------------------------------------------------------------------
# AdminApproval  New accounts wait for you to approve them under ACCOUNTS in the top bar.
# Open           Anyone who signs in is active immediately.
# SingleUser     Only your own account can ever be active.
#
# The first account to sign in is always activated and made administrator, in every mode.
#
# Leave this alone unless you mean it. Anyone can reach your sign-in page, and every
# account that gets created permanently consumes one of your Cloud project's 100
# unverified-app user slots -- a cap that cannot be reset.
AUTH_REGISTRATION=AdminApproval

# ---------------------------------------------------------------------------
# IMPORTANT: set the OAuth consent screen to "In production"
# ---------------------------------------------------------------------------
# Left in "Testing", Google expires refresh tokens after 7 DAYS, so background library
# sync silently stops working every week and every user has to reconnect. This is the
# single most common way a self-hosted instance appears broken.
#
# Publishing without completing verification is fine for a personal instance: users see
# an "unverified app" warning and click through, and you are capped at 100 users.

# ---------------------------------------------------------------------------
# Online metadata lookup (optional, off by default)
# ---------------------------------------------------------------------------
# Fills in what your files do not carry -- cover art most visibly, plus artist, album and
# year for untagged files -- by matching them against MusicBrainz.
#
# It never overwrites anything your files already say. Tags are what you chose; a match is
# a guess, and a guess only gets to fill a blank.
#
# Two things to know before enabling it:
#
#   * A lookup sends a track's title and artist to a third party. That is a small
#     disclosure, and if you host this for other people it is one you make on their behalf.
#   * MusicBrainz allows one request per second and requires a contact address in the
#     User-Agent. Both are honoured; the address below is what gets sent. Enabling lookups
#     without one is refused at startup.
#
# Expect roughly one track per second, capped at 200 per sync, resuming next time.
METADATA_ONLINE=false
METADATA_ONLINE_CONTACT=you@example.com
